{
  "name": "jira-test-case-generator",
  "private": true,
  "workspaces": ["src/frontend", "src/backend"],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace src/frontend\" \"npm run dev --workspace src/backend\"",
    "build": "npm run build --workspace src/frontend",
    "start": "npm run start --workspace src/backend",
    "test": "node --test src/backend/tests/*.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
